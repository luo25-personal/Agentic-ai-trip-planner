# 環境變數範本：複製成 .env.local 再填入真正的值。
# .env.local 已被 .gitignore 排除，不會上傳到 GitHub。
# 正式網站的值請填在 Vercel：Project → Settings → Environment Variables。
#
# ⚠️ 名稱不要加 NEXT_PUBLIC_ 或 VITE_ 前綴，否則會被打包進前端。

# 樂天 Web Service（https://webservice.rakuten.co.jp/ → Your Apps）
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# 呼叫樂天時帶的 Origin header，必須在樂天 App 的 Allowed websites 裡
# 格式：https://網域（不要結尾斜線或路徑）
RAKUTEN_ORIGIN=https://agentic-ai-trip-planner.vercel.app

# Gemini API（https://aistudio.google.com/ → Get API key）
# ⚠️ 只用 AI Studio 的免費金鑰，不要在 Google Cloud 啟用 Billing
GEMINI_API_KEY=
# 選填：指定模型，留空會用 gemini-flash-lite-latest（免費額度最多）
GEMINI_MODEL=

# 選填：Tavily 網路搜尋（https://tavily.com → Manage keys，免費方案不用綁卡）
# 留空的話 Agent 不會上網搜尋，其他功能照常
TAVILY_API_KEY=

# 選填：地名查詢服務。預設 nominatim（OpenStreetMap，支援日文車站名稱）
# 若需要停用 Nominatim，改成 open-meteo 即可，不用改程式
GEOCODER=
